<%- include('partials/head',{title,dashboardStyles:true}) %><%- include('partials/header',{title,active}) %>
<section class="welcome-row"><div><div class="eyebrow">TÀI CHÍNH CỦA BẠN</div><h1>Chào <%= currentUser.fullName.split(' ').slice(-1)[0] %>, hôm nay thế nào? <span class="wave">✦</span></h1><p class="subtext">Theo dõi dòng tiền để chủ động hơn trong cuộc sống sinh viên.</p></div><form class="month-picker" method="get"><label for="month">Tháng xem</label><input id="month" type="month" name="month" value="<%= month %>"><button class="btn btn-soft" type="submit">Xem</button></form></section>
<section class="stat-grid">
 <article class="stat-card income"><div class="stat-icon"><i class="bi bi-arrow-down-left-circle"></i></div><div class="stat-label">TỔNG KHOẢN THU</div><div class="stat-value"><%= money(summary.income) %></div><small>Trong tháng đang xem</small></article>
 <article class="stat-card expense"><div class="stat-icon"><i class="bi bi-arrow-up-right-circle"></i></div><div class="stat-label">TỔNG CHI TIÊU</div><div class="stat-value"><%= money(summary.expense) %></div><small><%= summary.count %> giao dịch thu/chi</small></article>
 <article class="stat-card balance"><div class="stat-icon"><i class="bi bi-wallet2"></i></div><div class="stat-label">CHÊNH LỆCH THU - CHI</div><div class="stat-value"><%= money(net) %></div><small><%= net>=0?'Bạn đang giữ được số dư dương':'Chi tiêu đang vượt khoản thu' %></small></article>
 <article class="stat-card budget"><div class="stat-icon"><i class="bi bi-pie-chart"></i></div><div class="stat-label">NGÂN SÁCH CÒN LẠI</div><div class="stat-value"><%= remaining===null?'Chưa đặt':remaining>=0?money(remaining):`Vượt ${money(Math.abs(remaining))}` %></div><small><%= totalBudget?`${budgetUsage.toFixed(0)}% ngân sách đã sử dụng`:'Hãy đặt ngân sách tháng' %></small></article>
</section>
<% if(totalBudget && budgetUsage>=80){ %><div class="budget-alert <%=budgetUsage>=100?'danger-alert':''%>"><i class="bi <%=budgetUsage>=100?'bi-exclamation-triangle':'bi-info-circle'%>"></i><span><b><%=budgetUsage>=100?'Bạn đã vượt ngân sách tháng này.':'Bạn đã sử dụng từ 80% ngân sách tháng.'%></b> <%=budgetUsage>=100?'Hãy xem lại các khoản chi còn lại.':'Cân nhắc các khoản chi không cần thiết trong những ngày tới.'%></span><a href="/budgets?month=<%=month%>">Xem ngân sách <i class="bi bi-arrow-right"></i></a></div><% } %>
<!-- Premium analytics are additive: the original 7-day chart, budget, category,
     savings goals, and latest transactions remain below untouched. -->
<section class="analytics-heading" aria-label="Bảng thống kê mở rộng">
  <div>
    <div class="eyebrow">PHÂN TÍCH TÀI CHÍNH</div>
    <h2>Góc nhìn toàn diện về dòng tiền</h2>
    <p class="subtext">Báo cáo được cập nhật từ giao dịch thực tế của bạn, theo tháng đã chọn.</p>
  </div>
  <a class="analytics-report-link" href="/reports"><i class="bi bi-graph-up-arrow"></i> Báo cáo chi tiết <i class="bi bi-arrow-up-right"></i></a>
</section>
<section class="analytics-top-grid" aria-label="Biểu đồ thống kê tài chính">
  <article class="panel analytics-panel cashflow-panel">
    <div class="panel-head analytics-panel-head">
      <div><div class="eyebrow">THU &amp; CHI</div><h2>Thu – chi theo tháng</h2><p class="subtext">So sánh khoản thu và chi trong các tháng gần đây</p></div>
      <div class="period-switch" role="group" aria-label="Khoảng thời gian cho biểu đồ theo tháng">
        <button type="button" data-period="3" aria-pressed="false">3 tháng</button>
        <button type="button" data-period="6" aria-pressed="true">6 tháng</button>
        <button type="button" data-period="12" aria-pressed="false">12 tháng</button>
      </div>
    </div>
    <div class="analytics-legend"><span><i class="legend-dot income-dot"></i>Thu nhập</span><span><i class="legend-dot expense-dot"></i>Chi tiêu</span></div>
    <div class="analytics-chart-holder cashflow-chart" id="chart-monthly"><span class="chart-loading">Đang chuẩn bị biểu đồ…</span></div>
    <div class="analytics-panel-bottom"><i class="bi bi-info-circle"></i> Chạm hoặc di chuột vào cột để xem số tiền từng tháng.</div>
  </article>
  <article class="panel analytics-panel distribution-panel">
    <div class="panel-head analytics-panel-head"><div><div class="eyebrow">CƠ CẤU CHI TIÊU</div><h2>Chi tiêu theo danh mục</h2><p class="subtext"><%= monthLabel(month) %></p></div><span class="analytics-head-icon expense-mark"><i class="bi bi-pie-chart-fill"></i></span></div>
    <div class="donut-wrap"><div id="chart-expense-donut" class="donut-visual" aria-label="Cơ cấu chi tiêu theo danh mục"><span class="chart-loading">Đang tải…</span></div><div id="legend-expense" class="donut-legend"></div></div>
    <div class="analytics-panel-bottom"><a href="/transactions?type=EXPENSE"><i class="bi bi-arrow-up-right"></i> Xem khoản chi</a></div>
  </article>
  <article class="panel analytics-panel distribution-panel">
    <div class="panel-head analytics-panel-head"><div><div class="eyebrow">NGUỒN THU NHẬP</div><h2>Thu nhập theo nguồn</h2><p class="subtext"><%= monthLabel(month) %></p></div><span class="analytics-head-icon income-mark"><i class="bi bi-cash-stack"></i></span></div>
    <div class="donut-wrap"><div id="chart-income-donut" class="donut-visual" aria-label="Cơ cấu thu nhập theo nguồn"><span class="chart-loading">Đang tải…</span></div><div id="legend-income" class="donut-legend"></div></div>
    <div class="analytics-panel-bottom"><a href="/transactions?type=INCOME"><i class="bi bi-arrow-up-right"></i> Xem khoản thu</a></div>
  </article>
</section>

<section class="analytics-heading trend-heading"><div><div class="eyebrow">XU HƯỚNG &amp; TIẾN ĐỘ</div><h2>Dòng tiền theo thời gian</h2><p class="subtext">Nhận biết thói quen chi tiêu và khả năng tích lũy.</p></div></section>
<section class="analytics-trend-grid">
  <article class="panel analytics-panel trend-panel">
    <div class="panel-head analytics-panel-head"><div><div class="eyebrow">TÍCH LŨY DÒNG TIỀN</div><h2>Thu – chi ròng lũy kế</h2><p class="subtext">Cộng dồn trong khoảng tháng đang hiển thị</p></div><span class="analytics-head-icon balance-mark"><i class="bi bi-graph-up"></i></span></div>
    <div id="chart-net" class="analytics-chart-holder trend-chart"><span class="chart-loading">Đang chuẩn bị…</span></div>
    <div class="analytics-panel-bottom">Chỉ phản ánh giao dịch đã ghi, không phải số dư tài khoản ngân hàng.</div>
  </article>
  <article class="panel analytics-panel trend-panel">
    <div class="panel-head analytics-panel-head"><div><div class="eyebrow">KIỂM SOÁT CHI TIÊU</div><h2>Chi tiêu lũy kế trong tháng</h2><p class="subtext">So với <%= monthLabel(analytics.insights.previousMonth) %></p></div><span class="analytics-head-icon expense-mark"><i class="bi bi-graph-down-arrow"></i></span></div>
    <div class="analytics-legend trend-legend"><span><i class="legend-dot expense-dot"></i>Tháng đang xem</span><span><i class="legend-dot previous-dot"></i>Tháng trước</span></div>
    <div id="chart-expense-trend" class="analytics-chart-holder trend-chart"><span class="chart-loading">Đang chuẩn bị…</span></div>
    <div class="analytics-panel-bottom"><span class="insight-change <%= analytics.insights.expenseChange===null?'':analytics.insights.expenseChange>0?'change-unfavorable':'change-favorable' %>"><i class="bi bi-arrow-left-right"></i> <%= analytics.insights.expenseChange===null?'Chưa đủ dữ liệu đối chiếu':`${analytics.insights.expenseChange>0?'+':''}${analytics.insights.expenseChange.toFixed(1)}% so với tháng trước` %></span></div>
  </article>
  <article class="panel analytics-panel trend-panel">
    <div class="panel-head analytics-panel-head"><div><div class="eyebrow">TĂNG TRƯỞNG THU NHẬP</div><h2>Thu nhập lũy kế trong tháng</h2><p class="subtext">So với <%= monthLabel(analytics.insights.previousMonth) %></p></div><span class="analytics-head-icon income-mark"><i class="bi bi-graph-up-arrow"></i></span></div>
    <div class="analytics-legend trend-legend"><span><i class="legend-dot income-dot"></i>Tháng đang xem</span><span><i class="legend-dot previous-dot"></i>Tháng trước</span></div>
    <div id="chart-income-trend" class="analytics-chart-holder trend-chart"><span class="chart-loading">Đang chuẩn bị…</span></div>
    <div class="analytics-panel-bottom"><span class="insight-change <%= analytics.insights.incomeChange===null?'':analytics.insights.incomeChange>=0?'change-favorable':'change-unfavorable' %>"><i class="bi bi-arrow-left-right"></i> <%= analytics.insights.incomeChange===null?'Chưa đủ dữ liệu đối chiếu':`${analytics.insights.incomeChange>0?'+':''}${analytics.insights.incomeChange.toFixed(1)}% so với tháng trước` %></span></div>
  </article>
</section>

<section class="insight-strip" aria-label="Nhận định nhanh về tài chính tháng">
 <article class="insight-tile"><span class="insight-icon violet"><i class="bi bi-piggy-bank"></i></span><div><div class="eyebrow">TỶ LỆ THU – CHI RÒNG</div><strong><%= analytics.insights.savingRate===null?'Chưa có khoản thu':`${analytics.insights.savingRate.toFixed(1)}%` %></strong><p><%= analytics.insights.savingRate===null?'Ghi nhận khoản thu để theo dõi tỷ lệ.':analytics.insights.savingRate>=0?'Tỷ lệ thu nhập còn lại sau chi tiêu.':'Chi đang vượt thu nhập trong tháng.' %></p></div></article>
 <article class="insight-tile"><span class="insight-icon coral"><i class="bi bi-cup-hot"></i></span><div><div class="eyebrow">CHI TRUNG BÌNH / NGÀY</div><strong><%= money(analytics.insights.avgExpensePerDay) %></strong><p><%= analytics.insights.daysObserved?`Tính trên ${analytics.insights.daysObserved} ngày của tháng đang xem.`:'Tháng chưa bắt đầu; chưa có số liệu.' %></p></div></article>
 <article class="insight-tile"><span class="insight-icon mint"><i class="bi bi-tags"></i></span><div><div class="eyebrow">DANH MỤC CHI NHIỀU NHẤT</div><strong><%= analytics.insights.topExpense ? analytics.insights.topExpense.name : 'Chưa có dữ liệu' %></strong><p><%= analytics.insights.topExpense ? `${money(analytics.insights.topExpense.amount)} trong ${monthLabel(month)}.` : 'Thêm giao dịch để nhận phân tích theo danh mục.' %></p></div></article>
</section>
<div class="dashboard-section-divider"><span>NGÂN SÁCH &amp; HOẠT ĐỘNG</span><i class="bi bi-arrow-down"></i></div>

<section class="dashboard-grid">
 <article class="panel chart-panel"><div class="panel-head"><div><div class="eyebrow">DÒNG TIỀN</div><h2>Thu chi 7 ngày gần đây</h2><p class="subtext">Số tiền phát sinh theo từng ngày</p></div><span class="panel-icon"><i class="bi bi-activity"></i></span></div>
  <div class="chart-legend"><span><i class="dot dot-expense"></i>Khoản chi</span><span><i class="dot dot-income"></i>Khoản thu</span></div>
  <div class="daily-chart"><% const maxDaily=Math.max(1,...daily.map(d=>Math.max(Number(d.expense),Number(d.income)))); daily.forEach(d=>{ %><div class="day-col"><div class="bars"><div class="bar expense-bar" style="height:<%= Math.max(3,Number(d.expense)/maxDaily*100) %>%" title="Chi <%= money(d.expense) %>"></div><div class="bar income-bar" style="height:<%= Math.max(3,Number(d.income)/maxDaily*100) %>%" title="Thu <%= money(d.income) %>"></div></div><small><%= d.label %></small></div><% }) %></div>
 </article>
 <article class="panel budget-panel"><div class="panel-head"><div><div class="eyebrow">KẾ HOẠCH CHI TIÊU</div><h2>Ngân sách tháng</h2><p class="subtext"><%= monthLabel(month) %></p></div><a class="text-link" href="/budgets?month=<%= month %>">Chi tiết <i class="bi bi-arrow-up-right"></i></a></div>
  <% if(totalBudget){ %><div class="budget-total"><strong><%= money(budgetSpent) %></strong><span>/ <%= money(totalBudget) %></span></div><div class="progress-track big"><span class="progress-fill <%= budgetUsage>=100?'over':budgetUsage>=80?'warning':'' %>" style="width:<%= Math.min(100,budgetUsage) %>%"></span></div><div class="budget-foot"><span><%= budgetUsage.toFixed(0) %>% đã sử dụng</span><b class="<%= remaining<0?'negative':'' %>"><%= remaining>=0?`${money(remaining)} còn lại`:`Vượt ${money(Math.abs(remaining))}` %></b></div><% }else{ %><div class="empty-mini"><i class="bi bi-pie-chart"></i><p>Bạn chưa đặt ngân sách cho tháng này.</p><a class="btn btn-primary btn-sm" href="/budgets">Thiết lập ngân sách</a></div><% } %>
  <div class="mini-budget-list"><% budgets.filter(b=>b.category_id).slice(0,4).forEach(b=>{const pct=Number(b.amount)>0?Math.min(100,Number(b.spent)/Number(b.amount)*100):0;%><div class="mini-budget"><div><span><i class="bi <%= b.icon||'bi-tag' %>" style="color:<%= b.color||'#64748b' %>"></i> <%= b.category_name %></span><b><%= pct.toFixed(0) %>%</b></div><div class="progress-track"><span class="progress-fill <%= pct>=100?'over':pct>=80?'warning':'' %>" style="width:<%= pct %>%"></span></div></div><%})%></div>
 </article>
</section>
<section class="dashboard-grid lower-grid">
 <article class="panel"><div class="panel-head"><div><div class="eyebrow">CÁC KHOẢN CHI</div><h2>Chi tiêu theo danh mục</h2></div><a class="text-link" href="/reports">Xem báo cáo <i class="bi bi-arrow-up-right"></i></a></div>
  <% if(breakdown.length){const maxCat=Math.max(1,...breakdown.map(x=>Number(x.amount)));%><div class="category-breakdown"><% breakdown.forEach(c=>{%><div class="category-row"><span class="category-symbol" style="--cat-color:<%=c.color%>"><i class="bi <%=c.icon%>"></i></span><div class="category-info"><div><b><%=c.name%></b><strong><%=money(c.amount)%></strong></div><div class="progress-track"><span class="progress-fill" style="width:<%=Number(c.amount)/maxCat*100%>;background:<%=c.color%>"></span></div></div></div><%})%></div><%}else{%><div class="empty-state"><i class="bi bi-receipt"></i><b>Chưa có khoản chi nào</b><p>Thêm giao dịch để xem biểu đồ phân tích.</p></div><%}%>
 </article>
 <article class="panel"><div class="panel-head"><div><div class="eyebrow">MỤC TIÊU CỦA BẠN</div><h2>Tiết kiệm có kế hoạch</h2><p class="subtext"><%=goalCount%> mục tiêu đang thực hiện</p></div><a class="text-link" href="/goals">Quản lý <i class="bi bi-arrow-up-right"></i></a></div><div class="goal-promo"><div class="goal-art"><i class="bi bi-piggy-bank"></i></div><b>Mỗi khoản nhỏ đều tạo nên thay đổi lớn.</b><p>Đặt mục tiêu tiết kiệm cho học phí, thiết bị học tập hoặc chuyến đi bạn mong muốn.</p><a class="btn btn-soft" href="/goals"><i class="bi bi-plus-lg"></i> Xem mục tiêu tiết kiệm</a></div></article>
</section>
<section class="panel recent-panel"><div class="panel-head"><div><div class="eyebrow">HOẠT ĐỘNG MỚI NHẤT</div><h2>Giao dịch gần đây</h2></div><a class="text-link" href="/transactions">Tất cả giao dịch <i class="bi bi-arrow-up-right"></i></a></div>
<% if(recent.length){%><div class="table-wrap"><table class="data-table"><thead><tr><th>Giao dịch</th><th>Danh mục</th><th>Ngày</th><th>Phương thức</th><th class="align-right">Số tiền</th></tr></thead><tbody><%recent.forEach(t=>{%><tr><td><div class="transaction-name"><span class="category-symbol small-symbol" style="--cat-color:<%=t.category_color%>"><i class="bi <%=t.category_icon%>"></i></span><span><b><%=t.title%></b><small><%=t.merchant||'Không có địa điểm' %></small></span></div></td><td><%=t.category_name%></td><td><%=date(t.transaction_date)%></td><td><%=methodLabel(t.payment_method)%></td><td class="align-right amount <%=t.type==='INCOME'?'positive':'negative'%>"><%=t.type==='INCOME'?'+':'−'%><%=money(t.amount)%></td></tr><%})%></tbody></table></div><%}else{%><div class="empty-state"><i class="bi bi-journal-plus"></i><b>Chưa có giao dịch</b><p>Bắt đầu bằng cách ghi lại khoản thu hoặc chi đầu tiên.</p><a class="btn btn-primary" href="/transactions/new">Thêm giao dịch</a></div><%}%>
</section>
<script type="application/json" id="dashboard-data"><%- JSON.stringify(analytics).replace(/</g,'\\u003c') %></script>
<script src="/js/dashboard.js" defer></script>
<%- include('partials/footer') %>
