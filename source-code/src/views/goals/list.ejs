<%- include('../partials/head',{title}) %><%- include('../partials/header',{title,active}) %>
<section class="page-heading"><div><div class="eyebrow">TIẾT KIỆM CHO TƯƠNG LAI</div><h1>Mục tiêu tiết kiệm</h1><p class="subtext">Chia mục tiêu lớn thành từng bước nhỏ và theo dõi tiến độ.</p></div></section>
<div class="goal-layout"><section class="panel"><div class="panel-head"><div><h2>Hành trình tiết kiệm</h2><p class="subtext">Các mục tiêu cá nhân của bạn.</p></div><span class="count-pill"><%=goals.length%> mục tiêu</span></div><div class="goal-list"><%goals.forEach(g=>{const pct=Math.min(100,Number(g.current_amount)/Number(g.target_amount)*100);%><article class="goal-card"><div class="goal-card-head"><span class="goal-icon"><i class="bi bi-piggy-bank"></i></span><div class="goal-main"><b><%=g.title%></b><small><%=g.target_date?`Dự kiến ${date(g.target_date)}`:'Chưa đặt ngày hoàn thành'%></small></div><span class="status-pill <%=g.status.toLowerCase()%>"><%=g.status==='ACTIVE'?'Đang thực hiện':g.status==='PAUSED'?'Tạm dừng':'Hoàn thành'%></span></div><div class="goal-amounts"><strong><%=money(g.current_amount)%></strong><span>mục tiêu <%=money(g.target_amount)%></span><b><%=pct.toFixed(0)%>%</b></div><div class="progress-track large"><span class="progress-fill <%=pct>=100?'complete':''%>" style="width:<%=pct%>%"></span></div><%if(g.note){%><p class="goal-note"><%=g.note%></p><%}%><div class="goal-actions"><form action="/goals/<%=g.id%>/progress" method="post" class="progress-form"><label>Cập nhật số tiền đã tiết kiệm</label><div><input type="number" name="amount" min="0" step="1" value="<%=g.current_amount%>" required><button class="btn btn-soft btn-sm">Cập nhật</button></div></form><%if(g.status!=='COMPLETED'){%><form action="/goals/<%=g.id%>/status" method="post"><input type="hidden" name="status" value="<%=g.status==='PAUSED'?'ACTIVE':'PAUSED'%>"><button class="btn btn-ghost btn-sm"><%=g.status==='PAUSED'?'Tiếp tục':'Tạm dừng'%></button></form><%}%><form action="/goals/<%=g.id%>/delete" method="post" data-confirm="Xóa mục tiêu này?"><button class="icon-action danger-action"><i class="bi bi-trash3"></i></button></form></div></article><%})%><%if(!goals.length){%><div class="empty-state"><i class="bi bi-bullseye"></i><b>Chưa có mục tiêu tiết kiệm</b><p>Đặt mục tiêu đầu tiên, ví dụ mua laptop, đóng học phí hoặc du lịch.</p></div><%}%></div></section>
<aside class="panel goal-create"><div class="panel-head"><div><div class="eyebrow">BẮT ĐẦU NGAY</div><h2>Tạo mục tiêu mới</h2></div></div><form class="stack-form" action="/goals" method="post"><div class="field"><label>Tên mục tiêu *</label><input name="title" minlength="2" maxlength="160" required placeholder="Ví dụ: Mua laptop mới"></div><div class="field"><label>Số tiền cần đạt (VNĐ) *</label><input type="number" name="target_amount" min="1" step="1" required placeholder="15000000"></div><div class="field"><label>Đã tiết kiệm (VNĐ)</label><input type="number" name="current_amount" min="0" step="1" value="0"></div><div class="field"><label>Ngày dự kiến hoàn thành</label><input type="date" name="target_date"></div><div class="field"><label>Ghi chú</label><textarea name="note" rows="3" placeholder="Kế hoạch để đạt mục tiêu..."></textarea></div><button class="btn btn-primary btn-block"><i class="bi bi-plus-lg"></i> Tạo mục tiêu</button></form><div class="goal-quote"><i class="bi bi-stars"></i><p>“Tiết kiệm không phải là có bao nhiêu tiền, mà là bắt đầu từ hôm nay.”</p></div></aside></div>
<%- include('../partials/footer') %>
