<%- include('../partials/head',{title}) %><%- include('../partials/header',{title,active}) %>
<section class="page-heading"><div><div class="eyebrow">GHI CHÉP TÀI CHÍNH</div><h1><%=transaction?'Chỉnh sửa giao dịch':'Thêm giao dịch mới'%></h1><p class="subtext">Nhập thông tin khoản thu hoặc chi đã phát sinh.</p></div><a class="btn btn-soft" href="/transactions"><i class="bi bi-arrow-left"></i> Quay lại</a></section>
<form class="panel form-panel" action="<%=transaction?`/transactions/${transaction.id}/update`:'/transactions'%>" method="post"><div class="form-section"><h2>Thông tin giao dịch</h2><p class="subtext">Các trường có dấu * là bắt buộc.</p><div class="form-grid">
 <div class="field span-2"><label>Đây là khoản gì? *</label><div class="segmented"><label><input type="radio" name="type" value="EXPENSE" <%=!transaction||transaction.type==='EXPENSE'?'checked':''%>><span><i class="bi bi-arrow-up-right-circle"></i> Khoản chi</span></label><label><input type="radio" name="type" value="INCOME" <%=transaction?.type==='INCOME'?'checked':''%>><span><i class="bi bi-arrow-down-left-circle"></i> Khoản thu</span></label></div></div>
 <div class="field span-2"><label for="title">Tên giao dịch *</label><input id="title" name="title" required maxlength="180" value="<%=transaction?.title||''%>" placeholder="Ví dụ: Ăn trưa, tiền làm thêm, mua giáo trình..."></div>
 <div class="field"><label for="amount">Số tiền (VNĐ) *</label><div class="money-input"><input id="amount" name="amount" type="number" min="1" max="999999999999" step="1" required value="<%=transaction?.amount||''%>" placeholder="0"><span>₫</span></div></div>
 <div class="field"><label for="transaction_date">Ngày giao dịch *</label><input id="transaction_date" name="transaction_date" type="date" required value="<%=transaction?String(transaction.transaction_date).slice(0,10):today%>"></div>
 <div class="field"><label for="category_id">Danh mục *</label><select id="category_id" name="category_id" required><option value="">Chọn danh mục</option><%categories.forEach(c=>{%><option value="<%=c.id%>" data-type="<%=c.type%>" <%=String(transaction?.category_id)===String(c.id)?'selected':''%>><%=c.name%></option><%})%></select></div>
 <div class="field"><label for="payment_method">Phương thức thanh toán</label><select id="payment_method" name="payment_method"><%Object.entries(paymentMethods).forEach(([k,v])=>{%><option value="<%=k%>" <%=transaction?.payment_method===k?'selected':(!transaction&&k==='CASH'?'selected':'')%>><%=v%></option><%})%></select></div>
 <div class="field"><label for="merchant">Nơi phát sinh / nguồn thu</label><input id="merchant" name="merchant" maxlength="160" value="<%=transaction?.merchant||''%>" placeholder="Ví dụ: Căn tin trường, cửa hàng, công ty..."></div>
 <div class="field span-2"><label for="note">Ghi chú</label><textarea id="note" name="note" rows="3" placeholder="Ghi chú thêm nếu cần..."><%=transaction?.note||''%></textarea></div>
</div></div><div class="form-actions"><a class="btn btn-ghost" href="/transactions">Hủy</a><button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> <%=transaction?'Lưu thay đổi':'Lưu giao dịch'%></button></div></form>
<%- include('../partials/footer') %>
