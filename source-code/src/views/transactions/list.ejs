<%- include('../partials/head',{title}) %><%- include('../partials/header',{title,active}) %>
<section class="page-heading"><div><div class="eyebrow">SỔ THU CHI CÁ NHÂN</div><h1>Giao dịch của tôi</h1><p class="subtext">Lưu lại mọi khoản tiền vào và ra để kiểm soát chi tiêu.</p></div><div class="heading-actions"><a class="btn btn-soft" href="/transactions/export.csv?<%= new URLSearchParams(queryParams) %>"><i class="bi bi-download"></i> Xuất CSV</a><a class="btn btn-primary" href="/transactions/new"><i class="bi bi-plus-lg"></i> Thêm giao dịch</a></div></section>
<div class="summary-strip"><div><span>Tổng khoản thu trong bộ lọc</span><b class="positive">+<%=money(totals.income)%></b></div><div><span>Tổng khoản chi trong bộ lọc</span><b class="negative">−<%=money(totals.expense)%></b></div><div><span>Số giao dịch</span><b><%=pagination.total%></b></div></div>
<section class="panel"><form class="filter-bar" method="get"><div class="field search-field"><label>Tìm giao dịch</label><div class="input-icon"><i class="bi bi-search"></i><input type="search" name="q" value="<%=filters.q%>" placeholder="Tên giao dịch, nơi phát sinh..."></div></div><div class="field"><label>Loại</label><select name="type"><option value="">Tất cả</option><option value="EXPENSE" <%=filters.type==='EXPENSE'?'selected':''%>>Khoản chi</option><option value="INCOME" <%=filters.type==='INCOME'?'selected':''%>>Khoản thu</option></select></div><div class="field"><label>Danh mục</label><select name="category_id"><option value="">Tất cả danh mục</option><%categories.forEach(c=>{%><option value="<%=c.id%>" <%=String(filters.categoryId)===String(c.id)?'selected':''%>><%=c.name%> · <%=c.type==='INCOME'?'Thu':'Chi'%></option><%})%></select></div><div class="field"><label>Từ ngày</label><input type="date" name="from" value="<%=filters.from||''%>"></div><div class="field"><label>Đến ngày</label><input type="date" name="to" value="<%=filters.to||''%>"></div><button class="btn btn-primary filter-submit">Lọc</button><a class="btn btn-ghost filter-clear" href="/transactions">Xóa lọc</a></form>
<div class="table-wrap"><table class="data-table"><thead><tr><th>Giao dịch</th><th>Danh mục</th><th>Ngày</th><th>Phương thức</th><th class="align-right">Số tiền</th><th></th></tr></thead><tbody><%transactions.forEach(t=>{%><tr><td><div class="transaction-name"><span class="category-symbol small-symbol" style="--cat-color:<%=t.category_color%>"><i class="bi <%=t.category_icon%>"></i></span><span><b><%=t.title%></b><small><%=t.merchant||t.note||'—'%></small></span></div></td><td><%=t.category_name%></td><td><%=date(t.transaction_date)%></td><td><%=methodLabel(t.payment_method)%></td><td class="align-right amount <%=t.type==='INCOME'?'positive':'negative'%>"><%=t.type==='INCOME'?'+':'−'%><%=money(t.amount)%></td><td><div class="row-actions"><a class="icon-action" href="/transactions/<%=t.id%>/edit" title="Sửa"><i class="bi bi-pencil"></i></a><form action="/transactions/<%=t.id%>/delete" method="post" data-confirm="Bạn có chắc muốn xóa giao dịch này?"><button class="icon-action danger-action" title="Xóa"><i class="bi bi-trash3"></i></button></form></div></td></tr><%})%><%if(!transactions.length){%><tr><td colspan="6"><div class="empty-state compact-empty"><i class="bi bi-search"></i><b>Không tìm thấy giao dịch</b><p>Thử thay đổi điều kiện lọc hoặc thêm giao dịch mới.</p></div></td></tr><%}%></tbody></table></div>
<div class="pagination-row"><span>Hiển thị <b><%=pagination.from%>–<%=pagination.to%></b> / <%=pagination.total%> giao dịch</span><div><%if(pagination.page>1){%><a class="page-btn" href="?<%=new URLSearchParams({...queryParams,page:pagination.page-1})%>"><i class="bi bi-chevron-left"></i></a><%}%><span class="page-current"><%=pagination.page%> / <%=pagination.pageCount%></span><%if(pagination.page<pagination.pageCount){%><a class="page-btn" href="?<%=new URLSearchParams({...queryParams,page:pagination.page+1})%>"><i class="bi bi-chevron-right"></i></a><%}%></div></div>
</section><%- include('../partials/footer') %>
