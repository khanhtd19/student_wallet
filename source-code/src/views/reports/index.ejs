<%- include('../partials/head',{title}) %><%- include('../partials/header',{title,active}) %>
<section class="page-heading"><div><div class="eyebrow">NHÌN LẠI THÓI QUEN</div><h1>Báo cáo & phân tích</h1><p class="subtext">Hiểu tiền của bạn đang đến từ đâu và được sử dụng như thế nào.</p></div><a class="btn btn-soft" href="/reports/export.csv?from=<%=from%>&to=<%=to%>"><i class="bi bi-download"></i> Xuất báo cáo CSV</a></section>
<form class="panel report-filter" method="get"><div class="field"><label>Từ ngày</label><input type="date" name="from" value="<%=from%>"></div><div class="field"><label>Đến ngày</label><input type="date" name="to" value="<%=to%>"></div><button class="btn btn-primary"><i class="bi bi-funnel"></i> Áp dụng</button></form>
<section class="stat-grid report-stats"><article class="stat-card income"><div class="stat-icon"><i class="bi bi-arrow-down-left-circle"></i></div><div class="stat-label">TỔNG THU</div><div class="stat-value"><%=money(summary.income)%></div></article><article class="stat-card expense"><div class="stat-icon"><i class="bi bi-arrow-up-right-circle"></i></div><div class="stat-label">TỔNG CHI</div><div class="stat-value"><%=money(summary.expense)%></div></article><article class="stat-card balance"><div class="stat-icon"><i class="bi bi-wallet2"></i></div><div class="stat-label">THU - CHI</div><div class="stat-value"><%=money(net)%></div></article><article class="stat-card budget"><div class="stat-icon"><i class="bi bi-journal-text"></i></div><div class="stat-label">SỐ GIAO DỊCH</div><div class="stat-value"><%=summary.count%></div></article></section>
<div class="two-column report-grid"><section class="panel"><div class="panel-head"><div><div class="eyebrow">PHÂN BỔ CHI TIÊU</div><h2>Chi theo danh mục</h2></div></div><%if(breakdown.length){const max=Math.max(...breakdown.map(r=>Number(r.amount)));%><div class="category-breakdown report-breakdown"><%breakdown.forEach(r=>{%><div class="category-row"><span class="category-symbol" style="--cat-color:<%=r.color%>"><i class="bi <%=r.icon%>"></i></span><div class="category-info"><div><b><%=r.name%></b><strong><%=money(r.amount)%></strong></div><div class="progress-track"><span class="progress-fill" style="width:<%=Number(r.amount)/max*100%>;background:<%=r.color%>"></span></div></div></div><%})%></div><%}else{%><div class="empty-state"><i class="bi bi-bar-chart"></i><b>Chưa có dữ liệu chi</b></div><%}%></section>
<section class="panel"><div class="panel-head"><div><div class="eyebrow">PHƯƠNG THỨC THANH TOÁN</div><h2>Bạn thường thanh toán bằng</h2></div></div><div class="method-list"><%methods.forEach(m=>{%><div class="method-row"><span><i class="bi <%=({CASH:'bi-cash',BANK_TRANSFER:'bi-bank',E_WALLET:'bi-phone',CARD:'bi-credit-card',OTHER:'bi-three-dots'})[m.payment_method]%>"></i><%=methodLabel(m.payment_method)%></span><div><b><%=money(m.amount)%></b><small><%=m.count%> giao dịch</small></div></div><%})%><%if(!methods.length){%><p class="empty-inline">Chưa có dữ liệu trong khoảng ngày này.</p><%}%></div></section></div>
<section class="panel"><div class="panel-head"><div><div class="eyebrow">BIẾN ĐỘNG THEO NGÀY</div><h2>Thu và chi trong khoảng thời gian</h2></div></div><div class="report-daily"><%const maxDaily=Math.max(1,...daily.map(d=>Math.max(Number(d.income),Number(d.expense))));daily.forEach(d=>{%><div class="report-day"><div class="report-day-bars"><span class="bar income-bar" style="height:<%=Math.max(2,Number(d.income)/maxDaily*100)%>%" title="Thu <%=money(d.income)%>"></span><span class="bar expense-bar" style="height:<%=Math.max(2,Number(d.expense)/maxDaily*100)%>%" title="Chi <%=money(d.expense)%>"></span></div><small><%=date(d.day)%></small></div><%})%><%if(!daily.length){%><div class="empty-inline">Không có giao dịch trong khoảng thời gian này.</div><%}%></div></section>
<%- include('../partials/footer') %>
