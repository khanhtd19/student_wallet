<%- include('../partials/head',{title}) %><%- include('../partials/header',{title,active}) %>
<section class="page-heading"><div><div class="eyebrow">THEO DÕI TÀI KHOẢN</div><h1>Lịch sử hoạt động</h1><p class="subtext">Các thao tác đăng nhập, cập nhật và ghi chép trên tài khoản của bạn.</p></div></section>
<section class="panel"><div class="activity-list"><%activities.forEach(a=>{%><div class="activity-item"><span class="activity-icon"><i class="bi <%=a.action==='LOGIN'?'bi-box-arrow-in-right':a.action.includes('DELETE')?'bi-trash3':a.action.includes('CREATE')?'bi-plus-circle':'bi-pencil-square'%>"></i></span><div class="activity-copy"><b><%=({LOGIN:'Đăng nhập',LOGOUT:'Đăng xuất',REGISTER:'Tạo tài khoản',CREATE_TRANSACTION:'Thêm giao dịch',UPDATE_TRANSACTION:'Sửa giao dịch',DELETE_TRANSACTION:'Xóa giao dịch',UPSERT_BUDGET:'Cập nhật ngân sách',CREATE_SAVINGS_GOAL:'Tạo mục tiêu tiết kiệm',UPDATE_PROFILE:'Cập nhật hồ sơ',CHANGE_PASSWORD:'Đổi mật khẩu'})[a.action]||a.action%></b><small><%=a.entity_type||'Tài khoản'%> <%=a.details&&Object.keys(a.details).length?'· '+JSON.stringify(a.details):''%></small></div><time><%=dateTime(a.created_at)%></time></div><%})%><%if(!activities.length){%><div class="empty-state"><i class="bi bi-clock-history"></i><b>Chưa có lịch sử hoạt động</b></div><%}%></div></section>
<%- include('../partials/footer') %>
